{
  "name": "jiuwan-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vue-tsc": "^3.0.6"
  }
}
