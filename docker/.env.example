# Optional settings for source builds. Copy to docker/.env and run Compose
# from the docker/ directory, or pass --env-file docker/.env from the root.
FRONTEND_PORT=8088
REDIS_LOCAL_PORT=16379
ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
# docker-compose.build.yaml uses Redis.
# docker-compose.build.memory.yaml uses memory, without a Redis service.
MEMORY_MAX_ROOMS=1000
